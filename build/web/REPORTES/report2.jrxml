<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="report2" pageWidth="555" pageHeight="802" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="ce8f75b6-7e13-412c-88ce-8a6de742b729">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="factura" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
     if(productos.`pro_iva`='0',detalleventas.`det_precio`*detalleventas.`det_cantidad`,' ') AS exenta,
     if(productos.`pro_iva`='5',detalleventas.`det_precio`*detalleventas.`det_cantidad`,' ') AS CINCO,
     if(productos.`pro_iva`='10',detalleventas.`det_precio`*detalleventas.`det_cantidad`,' ') AS DIEZ,
     detalleventas.`det_cantidad` AS detalleventas_det_cantidad,
     detalleventas.`det_precio` AS detalleventas_det_precio,
     productos.`pro_nombre` AS productos_pro_nombre,
     productos.`pro_iva` AS productos_pro_iva,
     detalleventas.`idventas` AS detalleventas_idventas
FROM
     `productos` productos INNER JOIN `detalleventas` detalleventas ON productos.`idproductos` = detalleventas.`idproductos`
where detalleventas.`idventas`=$P{factura}]]>
	</queryString>
	<field name="exenta" class="java.lang.String"/>
	<field name="CINCO" class="java.lang.String"/>
	<field name="DIEZ" class="java.lang.String"/>
	<field name="detalleventas_det_cantidad" class="java.lang.Integer"/>
	<field name="detalleventas_det_precio" class="java.lang.Integer"/>
	<field name="productos_pro_nombre" class="java.lang.String"/>
	<field name="productos_pro_iva" class="java.lang.Integer"/>
	<field name="detalleventas_idventas" class="java.lang.Integer"/>
