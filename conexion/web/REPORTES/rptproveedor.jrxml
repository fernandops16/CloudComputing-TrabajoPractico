	<queryString language="SQL">
		<![CDATA[SELECT
     proveedores.`id` AS proveedores_id,
     proveedores.`nombre` AS proveedores_nombre,
     proveedores.`ruc` AS proveedores_ruc,
     proveedores.`telefono` AS proveedores_telefono,
     proveedores.`correo` AS proveedores_correo,
     usuarios.`usu_nombre` AS usuarios_usu_nombre
FROM
     `proveedores` proveedores,
     `usuarios` usuarios]]>
	</queryString>
