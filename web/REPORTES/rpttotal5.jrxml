<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rpttotal5" pageWidth="555" pageHeight="802" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="377ae8f9-abf7-496b-813e-18772269b842">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="factura" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
     productos.`pro_iva` AS productos_pro_iva,
     detalleventas.`idventas` AS detalleventas_idventas,
     detalleventas.`det_cantidad` AS detalleventas_det_cantidad,
     detalleventas.`det_precio` AS detalleventas_det_precio,
   IFNULL(SUM(detalleventas.`det_cantidad` * detalleventas.`det_precio`)/21, 0) AS suma
FROM
     `productos` productos INNER JOIN `detalleventas` detalleventas ON productos.`idproductos` = detalleventas.`idproductos`
WHERE
     detalleventas.`idventas` = $P{factura}   AND productos.`pro_iva` = '5'
    ]]>
	</queryString>
	<field name="productos_pro_iva" class="java.lang.Integer"/>
	<field name="detalleventas_idventas" class="java.lang.Integer"/>
	<field name="detalleventas_det_cantidad" class="java.lang.Integer"/>
	<field name="detalleventas_det_precio" class="java.lang.Integer"/>
	<field name="suma" class="java.math.BigDecimal"/>
	<background>
		<band splitType="Stretch"/>
	</background>
	<detail>
		<band height="20" splitType="Stretch">
			<textField>
				<reportElement x="0" y="0" width="100" height="20" uuid="2c84b194-76c4-4a1d-a225-31c90a96c649"/>
				<textElement>
					<font size="12"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{suma}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
</jasperReport>
